(version 1)

(rule "RP2040 fanout"
	(condition "A.insideArea('RP2040_FANOUT')")
	(constraint clearance (min 0.127mm))
	(constraint track_width (min 0.127mm))
	(constraint via_diameter (min 0.4mm))
	(constraint hole_size (min 0.2mm))
)

(rule "Via size outside fanout"
	(condition "A.Type == 'Via' && !A.insideArea('RP2040_FANOUT')")
	(constraint via_diameter (min 0.45mm))
	(constraint hole_size (min 0.2mm))
)

(rule "HighCurrent width"
	(condition "A.NetClass == 'HighCurrent' && A.Type == 'Track'")
	(constraint track_width (min 0.6mm))
)

(rule "Board minimum outside RP2040 fanout"
	(condition "!A.insideArea('RP2040_FANOUT') && !B.insideArea('RP2040_FANOUT')")
	(constraint clearance (min 0.15mm))
	(constraint track_width (min 0.15mm))
)

(rule "Power USB QSPI SPI clearance outside RP2040 fanout"
	(condition "(A.NetClass == 'Power' || A.NetClass == 'USB' || A.NetClass == 'QSPI' || A.NetClass == 'SPI fast') && !A.insideArea('RP2040_FANOUT') && !B.insideArea('RP2040_FANOUT')")
	(constraint clearance (min 0.20mm))
)

(rule "VREG loop track width"
	(condition "A.insideArea('VREG_LOOP') && !A.insideArea('RP2040_FANOUT') && A.Type == 'Track'")
	(constraint track_width (min 0.3mm))
)

(rule "QSPI zone isolation"
	(condition "A.insideArea('QSPI_ZONE') && (A.NetClass == 'Analog' || A.NetClass == 'HighCurrent')")
	(constraint disallow track)
)

(rule "USB skew"
	(condition "A.NetClass == 'USB'")
	(constraint skew (max 5mm))
)

(rule "Heater and servo clearance"
	(condition "A.NetClass == 'HighCurrent' && !A.insideArea('RP2040_FANOUT') && !B.insideArea('RP2040_FANOUT')")
	(constraint clearance (min 0.25mm))
)

(rule "Crystal and Analog clearance outside RP2040 fanout"
	(condition "(A.NetClass == 'Crystal' || A.NetClass == 'Analog') && !A.insideArea('RP2040_FANOUT') && !B.insideArea('RP2040_FANOUT')")
	(constraint clearance (min 0.30mm))
)

(rule "Heater and servo separation from sensitive nets"
	(condition "A.NetClass == 'HighCurrent' && (B.NetClass == 'Analog' || B.NetClass == 'USB' || B.NetClass == 'Crystal') && !A.insideArea('RP2040_FANOUT') && !B.insideArea('RP2040_FANOUT')")
	(constraint clearance (min 3.0mm))
)

(rule "Analog quiet zone isolation"
	(condition "A.insideArea('ANALOG_QUIET') && (A.NetClass == 'HighCurrent' || A.NetClass == 'SPI fast' || A.NetClass == 'QSPI')")
	(constraint disallow track)
)

(rule "No pour at BMP280"
	(condition "A.insideArea('BMP_THERMAL_ISO') && A.Type == 'Zone'")
	(constraint disallow zone)
)

(rule "MECH_KEEPOUT allows only M3 mounting holes"
	(condition "A.insideArea('MECH_KEEPOUT') && (A.Type == 'Footprint' || A.Type == 'Pad') && !(A.Reference == 'H1' || A.Reference == 'H2' || A.Reference == 'H3')")
	(constraint disallow footprint)
	(constraint disallow pad)
)
